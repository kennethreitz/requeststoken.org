# Port for `uv run python app.py`. Responder's own default is 5042.
PORT=5042

# Website ID from the Umami dashboard at https://analytics.kennethreitz.org.
# Leave this unset and the tracker is left out of the page. The script URL
# defaults to that host; set UMAMI_SCRIPT_URL only to point somewhere else.
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://analytics.kennethreitz.org/script.js
