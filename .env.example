# Port for `uv run python app.py`. Responder's own default is 5042.
PORT=5042

# Optional for local review; required for shared observatory refreshes.
# Use a private Redis endpoint in production, with credentials and rediss://
# when provided by the host. Never commit real connection strings.
# REDIS_URL=redis://127.0.0.1:6379/0
# REQUESTS_OBSERVATORY_REDIS_PREFIX=requeststoken:observatory:v1
# REQUESTS_OBSERVATORY_REFRESH=0
